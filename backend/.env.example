# ============================================
# SCRAPBAZAAR BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/scrapbazaar
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/scrapbazaar

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cloudinary (Image Storage)
# Get credentials from https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Payments)
# Get credentials from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email (Nodemailer)
# For Gmail: enable 2FA and use App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=ScrapBazaar <noreply@scrapbazaar.in>

# Admin account (seeded on first run if no admin exists)
ADMIN_EMAIL=admin@scrapbazaar.in
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=ScrapBazaar Admin
